{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && mise exec -- sh .codex/hooks/stop.sh || exit 2",
            "timeout": 120,
            "statusMessage": "Running cached mise lint/type checks and fixes, formatting, and tests..."
          }
        ]
      }
    ]
  }
}
