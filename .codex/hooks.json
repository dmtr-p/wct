{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- sh \"$(git rev-parse --show-toplevel)/.codex/hooks/stop.sh\"",
            "timeout": 120,
            "statusMessage": "Running cached mise lint/type checks and fixes, formatting, and tests..."
          }
        ]
      }
    ]
  }
}
