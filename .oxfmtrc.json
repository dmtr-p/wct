{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "sortImports": {
    "newlinesBetween": false,
    "groups": [
      ["value-builtin", "type-builtin"],
      ["value-external", "type-external"],
      ["value-internal", "type-internal"],
      [
        "value-parent",
        "type-parent",
        "value-sibling",
        "type-sibling",
        "value-index",
        "type-index"
      ],
      "unknown"
    ]
  },
  "sortPackageJson": false,
  "ignorePatterns": ["bun.lock"]
}
