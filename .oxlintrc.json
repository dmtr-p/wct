{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/strict.json"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "react", "effecttsgo"],
  "rules": {
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "ink",
            "importNames": ["useInput"],
            "message": "Use useGuardedInput (src/tui/hooks/useGuardedInput.ts) for shared keyboard and mouse routing, including the paste fallback guard."
          }
        ]
      }
    ],
    "typescript/no-deprecated": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "react/globals": "off",
    "react/immutability": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "effecttsgo/any-unknown-in-error-context": "warn",
    "effecttsgo/crypto-random-uuid-in-effect": "error",
    "effecttsgo/effect-do-notation": "error",
    "effecttsgo/extends-native-error": "warn",
    "effecttsgo/global-console-in-effect": "error",
    "effecttsgo/global-date-in-effect": "error",
    "effecttsgo/global-fetch-in-effect": "error",
    "effecttsgo/global-random-in-effect": "error",
    "effecttsgo/global-timers-in-effect": "error",
    "effecttsgo/instance-of-schema": "error",
    "effecttsgo/nested-effect-gen-yield": "error",
    "effecttsgo/process-env-in-effect": "error",
    "effecttsgo/unsafe-effect-type-assertion": "warn"
  },
  "overrides": [
    {
      "files": ["src/tui/hooks/useGuardedInput.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    }
  ]
}
