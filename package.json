{
  "name": "wct",
  "version": "2.1.0",
  "description": "Git worktree workflow automation CLI",
  "module": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wct": "src/index.ts"
  },
  "scripts": {
    "start": "bun run build:browser && bun run src/index.ts",
    "test": "bun --bun node_modules/.bin/vitest run",
    "lint": "bun run --bun oxlint --deny-warnings .",
    "lint:fix": "bun run --bun oxlint --fix --deny-warnings .",
    "typecheck": "bun --bun node_modules/.bin/tsc --noEmit",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "build": "bun run scripts/build.ts",
    "build:browser": "bun run scripts/build-browser.ts",
    "build:all": "bun run scripts/build-all.ts",
    "prepare": "bun run --bun effect-tsgo patch --typescript --oxlint && bun run build:browser"
  },
  "devDependencies": {
    "@effect/tsgo": "0.64.1",
    "@effect/vitest": "4.1.2",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2005",
    "react-devtools-core": "8.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "effect": "4.1.2",
    "ink": "8.0.0",
    "react": "19.3.1"
  }
}
