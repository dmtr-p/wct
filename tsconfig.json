{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    "noPropertyAccessFromIndexSignature": false,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect",
          "@effect/platform-bun",
          "@effect/vitest"
        ],
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "warning",
          "returnEffectInGen": "warning",
          "tryCatchInEffectGen": "warning",
          "runEffectInsideEffect": "warning",
          "unsafeEffectTypeAssertion": "warning",
          "extendsNativeError": "warning"
        },
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": false
      }
    ]
  }
}
